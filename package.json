{
  "name": "agent-village",
  "version": "0.1.0",
  "description": "A living architect-table village for evidence-backed project work, with agent activity as a separate non-authoritative overlay.",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "connect:claude": "tsx scripts/connect-claude.ts",
    "disconnect:claude": "tsx scripts/connect-claude.ts --remove",
    "build": "vite build",
    "e2e": "playwright test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^24.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
